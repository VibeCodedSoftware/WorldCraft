{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WorldCraft",
  "version": "1.0.0",
  "identifier": "com.craftapps.worldcraft",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "WorldCraft",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "maximized": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "publisher": "CraftApps",
    "copyright": "CraftApps",
    "shortDescription": "WorldCraft procedural world builder",
    "longDescription": "WorldCraft: procedural terrain, trees, rocks, scatter, water, roads, snow, seasons and structures for GameCraft.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"]
  }
}
